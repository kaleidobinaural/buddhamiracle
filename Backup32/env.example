# Temple of Light — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
# (On Cloudflare Pages, NEXTAUTH_URL is set automatically)

# ── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Admin access (comma-separated emails) ───────────────────
ADMIN_EMAILS=your@email.com
NEXT_PUBLIC_ADMIN_EMAILS=your@email.com

# ── Lemon Squeezy (payment) ─────────────────────────────────
# The secret shown in your Lemon Squeezy Webhook settings
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Product IDs from your Lemon Squeezy store dashboard
# 🪷 20 Lotus Petals package
LEMONSQUEEZY_PRODUCT_ID_20=12345
# 🪷 60 Lotus Petals package
LEMONSQUEEZY_PRODUCT_ID_60=12346

# Public link to your Lemon Squeezy store (shown in upgrade modal)
NEXT_PUBLIC_LEMONSQUEEZY_STORE_URL=https://your-store.lemonsqueezy.com
